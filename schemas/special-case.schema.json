{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tennessee Digital Rights Tracker Special Case Metadata",
  "type": "object",
  "required": [
    "title",
    "case_id",
    "date_opened",
    "last_reviewed",
    "scope_start",
    "status",
    "level",
    "category",
    "jurisdiction",
    "confidence",
    "summary",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 8
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date_opened": {
      "type": ["string", "object"]
    },
    "last_reviewed": {
      "type": ["string", "object"]
    },
    "scope_start": {
      "type": ["string", "object"]
    },
    "scope_end": {
      "type": ["string", "object", "null"]
    },
    "status": {
      "enum": [
        "Proposed",
        "Monitoring",
        "Active",
        "Blocked",
        "Enjoined",
        "Repealed",
        "Expired",
        "Resolved"
      ]
    },
    "level": {
      "enum": ["Local", "State", "Federal", "Multi-level"]
    },
    "category": {
      "enum": [
        "lgbtq-trans-policy",
        "government-surveillance",
        "health-data-privacy",
        "online-identity-age-verification",
        "government-ai-automation",
        "digital-civic-information",
        "election-systems-data"
      ]
    },
    "jurisdiction": {
      "type": "string"
    },
    "confidence": {
      "enum": ["High", "Medium", "Low"]
    },
    "summary": {
      "type": "string",
      "minLength": 30
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "revision_history": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
